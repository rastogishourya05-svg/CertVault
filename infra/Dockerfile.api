FROM python:3.13-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd -m certvault
COPY apps ./apps
RUN mkdir /app/.local && chown -R certvault:certvault /app
USER certvault
ENV CERTVAULT_MODE=unconfigured
CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
